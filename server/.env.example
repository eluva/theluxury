# Port of the API server
PORT=8080

# Where products come from: demo | billz
DATA_SOURCE=demo
CATALOG_CACHE_SECONDS=300

# --- Telegram ---
# Bot token from @BotFather (used to verify Mini App users and to send order notifications)
BOT_TOKEN=
# Chat / group id where managers receive new orders (e.g. -1001234567890)
MANAGER_CHAT_ID=
# 1 = accept orders only from inside Telegram (signed initData)
REQUIRE_TELEGRAM=0

# --- BILLZ ---
BILLZ_API_URL=https://api-admin.billz.ai
BILLZ_SECRET_TOKEN=
# Use prices/stock of a single shop (leave empty to sum all shops)
BILLZ_SHOP_ID=
# Regex for the attribute that stores shoe size
BILLZ_SIZE_ATTRIBUTE=размер|size|o‘lcham|olcham
